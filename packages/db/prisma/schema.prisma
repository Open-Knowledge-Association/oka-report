// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ArticleSource {
  MEDIAWIKI
  OUTREACH_DASHBOARD
}

enum PageviewType {
  DAILY
  CUMULATIVE
}

enum PageviewAgentType {
  USER       // Human views only
  ALL_AGENTS // All views (human + bot)
}

/// Snapshot aggregation granularity
enum Granularity {
  DAY
  MONTH
  YEAR
}

/// A tracked program (e.g. "OKA") that groups editors and articles.
/// Source of truth for the program window and membership.
/// NOTE: data window starts 2026-01-01 (fresh start; no historical data).
model Program {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  school    String
  /// Program window start. Set to 2026-01-01 for the fresh start.
  startAt   DateTime
  endAt     DateTime
  source    String   @default("outreach_dashboard")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ProgramMember[]
  articles Article[]
  snapshots MetricSnapshot[]

  @@map("programs")
}

/// Join table: editor membership in a program with its enrollment timestamp.
/// Edit attribution uses this timestamp: contributions before enrolledAt are
/// excluded from program metrics.
model ProgramMember {
  id         String   @id @default(cuid())
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId  String
  editor     Editor   @relation(fields: [editorId], references: [id], onDelete: Cascade)
  editorId   String
  enrolledAt DateTime
  externalId String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([programId, editorId])
  @@index([editorId])
  @@index([programId, isActive])
  @@map("program_members")
}

/// Registered Wikipedia editors to track
/// These are OKA members, grantees, or other editors whose contributions we monitor
model Editor {
  id String @id @default(cuid())

  /// Wikipedia username (case-sensitive, must match exactly)
  /// Format: Underscores for spaces (e.g., "Jimbo_Wales" not "Jimbo Wales")
  /// Example: "Jimbo_Wales", "Example_User_123"
  username String @unique

  /// Wikimedia global user ID (optional, for future cross-wiki tracking)
  /// Example: 12345678
  wikimediaUserId Int?

  /// Whether this editor is actively being tracked
  /// Set to false to pause syncing without deleting historical data
  /// Example: true (active), false (paused)
  isActive Boolean @default(true)

  /// Source of this editor record for audit trail
  /// Values: "manual" (added via UI), "csv_import" (bulk import), 
  ///         "outreach_dashboard" (future), "wiki_category" (future)
  /// Example: "manual"
  source String @default("manual")

   /// External ID from source system (for sync deduplication)
   /// Example: Outreach Dashboard participant ID "12345"
   externalId String? @unique

  contributions    Contribution[]
  commonsUploads   CommonsUpload[]
  createdArticles  Article[]       @relation("CreatedArticles")
  programMembers   ProgramMember[]
  periodActivities PeriodEditorActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("editors")
}

/// Wikipedia articles created or modified by tracked editors
model Article {
  id String @id @default(cuid())

  /// MediaWiki page ID (unique within each wiki project)
  /// Example: 12345678
  pageId Int?

  /// Article title as it appears in the URL (with underscores)
  /// Format: "Article_Title" not "Article Title"
  /// Example: "Borobudur_Temple", "Komodo_dragon"
  title String

  /// Wikipedia language/project code
  /// Format: "{lang}.wikipedia.org" 
  /// Example: "en.wikipedia.org", "id.wikipedia.org", "commons.wikimedia.org"
  wikiProject String

  /// Source system for this article
  source ArticleSource @default(MEDIAWIKI)

  /// Outreach Dashboard article ID (if sourced from Outreach)
  outreachId Int? @unique

  /// Full URL to the article on Wikipedia
  url String?

  /// Sum of character changes across all edits (Outreach Dashboard)
  characterSum Int @default(0)

  /// Number of references in the article (Outreach Dashboard)
  referencesCount Int @default(0)

  /// Whether this is a newly created article (Outreach Dashboard)
  isNewArticle Boolean @default(false)

  /// Quality rating from Outreach Dashboard
  rating String?

  /// Reference to the tracked editor who created this article (if any)
  /// Null if article was created by a non-tracked editor
  createdByEditor   Editor? @relation("CreatedArticles", fields: [createdByEditorId], references: [id])
  createdByEditorId String?

  /// Program this article belongs to (null = legacy/untagged)
  program   Program? @relation(fields: [programId], references: [id])
  programId String?

  /// Author verification state: unknown, verified_tracked, verified_external, unavailable
  authorStatus String @default("unknown")
  authorUsername String?
  authorVerifiedAt DateTime?

  /// When this article was first created on Wikipedia
  /// Fetched from MediaWiki API (first revision timestamp)
  /// Example: "2024-03-15T10:30:00Z"
  articleCreatedAt DateTime?

  contributions Contribution[]
  pageviews     Pageview[]
  historicalPageviews HistoricalPageview[]
  periodActivities PeriodArticleActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, wikiProject])
  @@index([programId])
  @@map("articles")
}

/// Individual edit/contribution made by a tracked editor
model Contribution {
  id String @id @default(cuid())

  editor   Editor @relation(fields: [editorId], references: [id])
  editorId String

  article   Article @relation(fields: [articleId], references: [id])
  articleId String

  /// MediaWiki revision ID (unique identifier for this edit)
  /// Example: 1234567890
  revisionId Int

  /// Parent revision ID (the revision this edit was based on)
  /// Null for the first revision (article creation)
  /// Example: 1234567889
  parentId Int?

  /// Net bytes changed in this edit (positive = added, negative = removed)
  /// Example: 1500 (added 1.5KB), -200 (removed 200 bytes)
  bytesChanged Int

  /// Estimated words added (calculated as bytesChanged / 6)
  /// Based on Wikimedia's standard estimation methodology
  /// Example: 250 (approximately 250 words added)
  wordsAdded Int @default(0)

  /// Whether this edit created the article (first revision)
  /// True only for the initial creation edit
  /// Example: true (article creation), false (subsequent edit)
  isCreation Boolean @default(false)

  /// Timestamp of when this edit was made on Wikipedia
  /// Example: "2026-01-15T10:30:00Z"
  editTimestamp DateTime

  createdAt DateTime @default(now())

  @@unique([revisionId, articleId])
  @@index([editorId])
  @@index([articleId])
  @@index([editTimestamp])
  @@index([editorId, editTimestamp])
  @@index([articleId, editTimestamp])
  @@map("contributions")
}

/// Daily pageview statistics for tracked articles
/// Only tracks articles CREATED by tracked editors (per PRD requirement)
model Pageview {
  id String @id @default(cuid())

  article   Article @relation(fields: [articleId], references: [id])
  articleId String

  /// Date for this pageview count (daily granularity)
  /// Format: Date only, no time component
  /// Example: "2026-01-15"
  date DateTime @db.Date

  /// Pageview record type (daily or cumulative snapshot)
  type PageviewType @default(DAILY)

  /// Agent type for this pageview count (human-only or all traffic including bots)
  agentType PageviewAgentType @default(ALL_AGENTS)

  /// Number of pageviews on this date
  /// Source: Wikimedia Pageviews API (user traffic only, excludes bots)
  /// Example: 1523
  views Int

  /// Cumulative view count as of snapshot date
  /// Used when type = CUMULATIVE
  cumulativeViews Int?

  createdAt DateTime @default(now())

  @@unique([articleId, date, type, agentType])
  @@index([date])
  @@index([agentType])
  @@map("pageviews")
}

/// Monthly historical pageview aggregates used by annual reports
model HistoricalPageview {
  id String @id @default(cuid())
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String
  periodStart DateTime @db.Date
  periodEnd DateTime @db.Date
  granularity String @default("MONTHLY")
  agentType PageviewAgentType @default(ALL_AGENTS)
  views Int?
  status String @default("SUCCESS")
  error String?
  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([articleId, periodStart, granularity, agentType])
  @@index([periodStart])
  @@index([status])
  @@map("historical_pageviews")
}

/// Pre-aggregated metric snapshot (DAY/MONTH/YEAR granularity) for fast reporting.
/// Rollups are built from the raw tables by the snapshot_build job, layered:
/// DAY rows are summed into MONTH rows, MONTH into YEAR rows. The API reads
/// only this table (no on-the-fly aggregation).
model MetricSnapshot {
  id         String      @id @default(cuid())
  granularity Granularity
  periodStart DateTime   @db.Date
  periodEnd   DateTime   @db.Date
  program     Program?   @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId   String?
  wikiProject String     @default("")
  agentType   String     @default("ALL_AGENTS") // ALL_AGENTS (total) | USER (humans only)

  edits           Int
  wordsAdded      Int
  articlesCreated Int
  articlesEdited  Int
  editors         Int
  refsAdded       Int
  viewsTotal      Int     // pageviews of ALL articles in the period
  viewsActive     Int     // pageviews of articles created/edited in the period
  commonsUploads  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([granularity, periodStart, programId, wikiProject, agentType])
  @@index([granularity, periodStart])
  @@index([programId, granularity, periodStart])
  @@index([wikiProject, granularity, periodStart])
  @@map("metric_snapshots")
}

/// Per-period article activity detail (which articles were created/edited in a
/// period). Only articles with program activity are recorded (created/edited by
/// program editors within the program window). Enables detailed reports at
/// DAY/MONTH/YEAR level.
model PeriodArticleActivity {
  id          String      @id @default(cuid())
  granularity Granularity
  periodStart DateTime    @db.Date
  periodEnd   DateTime    @db.Date
  article     Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId   String
  programId   String?
  wikiProject String      @default("")

  edits           Int
  wordsAdded      Int
  isCreated       Boolean   @default(false) // article created in this period
  viewsTotal      Int       @default(0)
  viewsActive     Int       @default(0)
  refsAdded       Int       @default(0)

  createdAt DateTime @default(now())

  @@unique([granularity, periodStart, articleId])
  @@index([granularity, periodStart])
  @@index([articleId])
  @@index([programId, granularity, periodStart])
  @@map("period_article_activity")
}

/// Per-period editor activity detail (what each editor did in a period).
/// Enables detailed reports at DAY/MONTH/YEAR level.
model PeriodEditorActivity {
  id          String      @id @default(cuid())
  granularity Granularity
  periodStart DateTime    @db.Date
  periodEnd   DateTime    @db.Date
  editor      Editor      @relation(fields: [editorId], references: [id], onDelete: Cascade)
  editorId    String
  programId   String?

  edits           Int
  wordsAdded      Int
  articlesCreated Int
  articlesEdited  Int
  commonsUploads  Int

  createdAt DateTime @default(now())

  @@unique([granularity, periodStart, editorId])
  @@index([granularity, periodStart])
  @@index([editorId])
  @@index([programId, granularity, periodStart])
  @@map("period_editor_activity")
}

/// Join table linking articles to editors
/// Tracks which editors worked on which unified articles
/// NOTE: removed in schema cleanup — article-editor links come from contributions
/// [REMOVED]

/// Wikimedia Commons file uploads by tracked editors
model CommonsUpload {
  id String @id @default(cuid())

  editor   Editor @relation(fields: [editorId], references: [id])
  editorId String

  /// Filename on Commons (without "File:" namespace prefix)
  /// Format: Exact filename with extension
  /// Example: "Borobudur_sunrise_2024.jpg"
  fileName String

  /// Full URL to the file on Commons
  /// Example: "https://upload.wikimedia.org/wikipedia/commons/a/ab/Borobudur_sunrise_2024.jpg"
  fileUrl String

  /// File size in bytes
  /// Example: 2500000 (2.5 MB)
  fileSize Int?

  /// MIME type of the uploaded file
  /// Example: "image/jpeg", "image/png", "video/webm", "application/pdf"
  mimeType String?

  /// When the file was uploaded to Commons
  /// Example: "2026-01-15T10:30:00Z"
  uploadedAt DateTime

  createdAt DateTime @default(now())

  @@unique([fileName])
  @@index([editorId])
  @@map("commons_uploads")
}

/// Background sync job tracking for monitoring and debugging
model SyncJob {
  id String @id @default(cuid())

  /// Parent job ID for sub-jobs in a full sync
  /// Null for top-level jobs, set for child jobs
  parentJobId String?
  parentJob   SyncJob?  @relation("SubJobs", fields: [parentJobId], references: [id])
  subJobs     SyncJob[] @relation("SubJobs")

  /// Type of sync operation
  /// Values: "full" (all data), "contributions", "pageviews", "commons", "editors", "outreach_articles"
  /// Example: "full"
  jobType String

  /// Current status of the job
  /// Values: "pending", "running", "completed", "failed", "cancelled"
  /// Example: "running"
  status String

  /// Legacy cancellation flag (deprecated - use status="cancelled" instead)
  isCancelled Boolean @default(false)

  /// When the job started execution
  /// Null if still pending
  startedAt DateTime?

  /// When the job finished (success or failure)
  completedAt DateTime?

  /// Error message if job failed
  /// Example: "Rate limited by Wikimedia API after 1000 requests"
  error String?

  /// Job statistics and metadata as JSON
  /// Example: {"editorsProcessed": 50, "contributionsSynced": 1234, "errors": 2}
  metadata Json?

  /// Durable worker lease. Only the current owner may renew/complete the job.
  leaseOwner String?
  leaseVersion Int @default(0)
  heartbeatAt DateTime?
  leaseExpiresAt DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([jobType])
  @@index([parentJobId])
  @@map("sync_jobs")
}

/// Daily aggregated stats for reporting
model SchedulerSetting {
  id String @id
  enabled Boolean @default(true)
  disabledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("scheduler_settings")
}

model SchedulerSettingEvent {
  id String @id @default(cuid())

  schedulerId String
  enabled Boolean
  reason String?
  source String?

  createdAt DateTime @default(now())

  @@index([schedulerId])
  @@index([createdAt])
  @@map("scheduler_setting_events")
}

/// Bootstrap state singleton for first-deploy full sync lifecycle
/// Ensures only one bootstrap runs and gates all scheduled jobs until completion
model BootstrapState {
  /// Singleton ID - always "singleton" to enforce single row
  id String @id @default("singleton")

  /// Current bootstrap state: pending, running, completed, failed
  /// - pending: not yet started
  /// - running: bootstrap in progress
  /// - completed: bootstrap finished successfully
  /// - failed: bootstrap failed and requires retry
  state String @default("pending")

  /// When bootstrap was started
  startedAt DateTime?

  /// When bootstrap completed successfully
  completedAt DateTime?

  /// Lease expiration timestamp for timeout safeguard (default 48h)
  /// If running state exists past this time, considered stale
  leaseExpiresAt DateTime?

  /// Root sync job ID for the bootstrap full sync
  /// Used to track bootstrap progress and completion
  rootJobId String?

  /// When bootstrap failed
  failedAt DateTime?

  /// Reason for bootstrap failure
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bootstrap_state")
}

/// Daily stats per editor for reporting
